# Ciclo TRIMESTRALE: gennaio, aprile, luglio, ottobre — Roma il 1°, le
# province il 7-10, alle 3:00 UTC. La cadenza sta QUI, nel campo mese
# della schedulazione: niente righe commentate da riattivare a memoria.
# ATTENZIONE: il server e' su Etc/UTC, quindi sono le 5:00 italiane con
# l'ora legale e le 4:00 con quella solare. Per farle diventare le 3:00
# italiane basta aggiungere `CRON_TZ=Europe/Rome` come prima riga.
# Trimestrale dal 2026-09-23 (decisione del cliente): il ripasso completo
# del Lazio e' stato fatto a settembre, e a cadenza mensile il sourcing —
# l'82% del costo — si ripagherebbe ogni mese per trovare in gran parte
# le stesse aziende (~80 EUR/trimestre contro ~240).
#
# La guardia `202610` su ogni riga SCADE DA SOLA: il trimestre di ottobre
# 2026 e' gia' stato eseguito a mano il 19-21/9 (tutto il Lazio), e il 1/10
# il periodo Apify in corso non avrebbe comunque credito per Roma. Da
# gennaio 2027 la guardia e' sempre vera e il cron fa tutto lui.
#
# ORDINE PER DENSITÀ, non alfabetico: RM(1), LT(7), FR(8), VT(9), RI(10). Il piano Apify ha
# un tetto mensile rigido (~$19) e il ciclo completo gli arriva vicino: se
# il credito finisse, a saltare deve essere l'ultima della fila, cioè Rieti
# — 15 comuni, la provincia con meno aziende. In ordine alfabetico sarebbe
# saltata Viterbo, che ne ha di più, e per nessun motivo.
# Il consumo residuo si legge in fondo al log di ogni giorno.
0 3 1 1,4,7,10 * test $(date +\%Y\%m) -ne 202610 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia RM >> /var/log/pipeline-rm.log 2>&1
#
# Le quattro province partono il 7-10 e non il 2-5: il periodo di
# fatturazione Apify va dal 7 di un mese al 6 del successivo (abbonamento
# del 2026-09-07) e il tetto e' rigido (~$19). Cosi' Roma resta sola in
# coda a un periodo e le altre quattro aprono il successivo col credito
# rinnovato — a trimestre pieno il tetto non si avvicina nemmeno.
0 3 7 1,4,7,10 * test $(date +\%Y\%m) -ne 202610 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia LT >> /var/log/pipeline-lt.log 2>&1
0 3 8 1,4,7,10 * test $(date +\%Y\%m) -ne 202610 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia FR >> /var/log/pipeline-fr.log 2>&1
0 3 9 1,4,7,10 * test $(date +\%Y\%m) -ne 202610 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia VT >> /var/log/pipeline-vt.log 2>&1
0 3 10 1,4,7,10 * test $(date +\%Y\%m) -ne 202610 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia RI >> /var/log/pipeline-ri.log 2>&1
#
# REGIONI NUOVE (2026-10-07, costi approvati dal committente). Cadenza
# trimestrale come il Lazio, ma SFALSATA di mese: il periodo Apify va dal 7
# al 6 e il piano ha un tetto di 100 USD al mese, quindi ogni periodo porta
# un solo gruppo di regioni (Lazio ~16 USD, Toscana+Abruzzo ~33, le altre
# tre ~40). Una provincia al giorno alle 3:00 UTC, dal giorno 8: il controllo
# crediti di ogni ciclo vuole la stima della provincia piu' 10 USD di margine,
# e un ciclo che non ci sta non parte (ESITO nel log, riparte il mese dopo).
#
# Toscana e Abruzzo: febbraio, maggio, agosto, novembre, dall'8. Guardia 202611:
# la Toscana e' raccolta a mano a ottobre 2026, il primo ripasso e' febbraio 2027.
0 3 8 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia FI >> /var/log/pipeline-fi.log 2>&1
0 3 9 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia PO >> /var/log/pipeline-po.log 2>&1
0 3 10 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia PT >> /var/log/pipeline-pt.log 2>&1
0 3 11 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia LU >> /var/log/pipeline-lu.log 2>&1
0 3 12 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia MS >> /var/log/pipeline-ms.log 2>&1
0 3 13 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia PI >> /var/log/pipeline-pi.log 2>&1
0 3 14 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia LI >> /var/log/pipeline-li.log 2>&1
0 3 15 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia AR >> /var/log/pipeline-ar.log 2>&1
0 3 16 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia SI >> /var/log/pipeline-si.log 2>&1
0 3 17 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia GR >> /var/log/pipeline-gr.log 2>&1
0 3 18 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia AQ >> /var/log/pipeline-aq.log 2>&1
0 3 19 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia CH >> /var/log/pipeline-ch.log 2>&1
0 3 20 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia PE >> /var/log/pipeline-pe.log 2>&1
0 3 21 2,5,8,11 * test $(date +\%Y\%m) -ne 202611 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia TE >> /var/log/pipeline-te.log 2>&1
#
# Campania, Puglia e Marche: marzo, giugno, settembre, dicembre, dall'8.
# Guardia 202612: raccolte a mano fra ottobre e novembre 2026, primo ripasso a marzo 2027.
0 3 8 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia NA >> /var/log/pipeline-na.log 2>&1
0 3 9 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia CE >> /var/log/pipeline-ce.log 2>&1
0 3 10 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia SA >> /var/log/pipeline-sa.log 2>&1
0 3 11 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia AV >> /var/log/pipeline-av.log 2>&1
0 3 12 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia BN >> /var/log/pipeline-bn.log 2>&1
0 3 13 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia BA >> /var/log/pipeline-ba.log 2>&1
