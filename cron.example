0 3 19 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia AN >> /var/log/pipeline-an.log 2>&1
0 3 20 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia PU >> /var/log/pipeline-pu.log 2>&1
0 3 21 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia MC >> /var/log/pipeline-mc.log 2>&1
0 3 22 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia AP >> /var/log/pipeline-ap.log 2>&1
0 3 23 3,6,9,12 * test $(date +\%Y\%m) -ne 202612 && cd /opt/agente-commerciale-pipeline && .venv/bin/python main.py --provincia FM >> /var/log/pipeline-fm.log 2>&1
#
# I tre saldi (Anthropic, Apify, Openapi) il primo del mese: una riga di
# log per accorgersi dei crediti PRIMA che li scopra un giro fallito.
# Alle 2:00, un'ora prima dei cicli trimestrali. Costo: ~0,10 EUR/mese
# (il canarino Openapi e' una visura vera: e' l'unico modo di leggere
# quel wallet, vedi crediti.py).
0 2 1 * * cd /opt/agente-commerciale-pipeline && .venv/bin/python crediti.py >> /var/log/pipeline-crediti.log 2>&1
#
# Ricontrollo giornaliero dei SOLI servizi in allarme (crediti.py --allarmi):
# se Claudia ricarica oggi, il banner rosso sparisce domani invece che al
# 1° del mese. Gratis per Apify e per Openapi a wallet vuoto; il pedaggio
# di 0,10 su Openapi si paga solo alla lettura che trova credito. I servizi
# ok restano alla riga mensile. Alle 6:00, dopo eventuali giri notturni.
0 6 * * * cd /opt/agente-commerciale-pipeline && .venv/bin/python crediti.py --allarmi >> /var/log/pipeline-crediti.log 2>&1
#
# Conservazione dei CANDIDATI (privacy, l'unica eccezione alla regola
# "niente cancellazioni"): chi non arriva al colloquio si cancella 90 giorni
# dopo l'ultimo aggiornamento, chi ci arriva (scartato dopo o assunto) 12
# mesi dopo; le righe di cache/candidati a 90 giorni. Una riga di log al
# giorno con quante righe toglie. Cancella davvero dal 7/10/2026: i giri in
# prova del 6-7/10 (0 da togliere su 266) erano coerenti, e la cancellazione
# e' promessa nel messaggio ai candidati.
30 4 * * * cd /opt/agente-commerciale-pipeline && .venv/bin/python candidati_ricerca.py --conservazione >> /var/log/candidati-conservazione.log 2>&1
